---
import type { Farm } from '../data/farms';
import { categoryById } from '../data/categories';
import FarmCover from './FarmCover.astro';
import Icon from './Icon.astro';

interface Props {
  farm: Farm;
  variant?: 'list' | 'tile';
  morph?: boolean;
}
const { farm, variant = 'list', morph = true } = Astro.props;
const href = `/fermes/${farm.slug}`;
const vt = morph ? `cover-${farm.slug}` : undefined;
---

{
  variant === 'list' ? (
    <article
      class="farm-card print print--sm"
      style={`--off:${categoryById[farm.cats[0]].color}`}
      data-farm-card
      data-slug={farm.slug}
      data-cats={farm.cats.join(' ')}
      data-labels={farm.labels.join('|')}
      data-search={`${farm.name} ${farm.commune} ${farm.products.map((p) => p.name).join(' ')} ${farm.labels.join(' ')}`}
      data-lat={farm.lat}
      data-lng={farm.lng}
      data-rating={farm.rating}
      tabindex="0"
    >
      <div class="farm-card__thumb" transition:name={vt}>
        <FarmCover farm={farm} variant="thumb" />
      </div>
      <div class="farm-card__body">
        <h3 class="farm-card__name serif">{farm.name}</h3>
        <p class="farm-card__meta">
          <span class="farm-card__dist">
            <Icon name="pin" size={15} class="pin" />
            <span data-distance>{farm.commune}</span>
          </span>
          <span class="dot">•</span>
          <span class="farm-card__rating">
            <Icon name="star" size={15} class="star" />
            {farm.rating.toFixed(1)} <span class="muted">({farm.reviews})</span>
          </span>
        </p>
        <p class="farm-card__status" data-status />
        <div class="farm-card__tags">
          {farm.cats.map((c) => (
            <span class="tag" style={`--c:${categoryById[c].tint}`}>
              {categoryById[c].short}
            </span>
          ))}
        </div>
      </div>
      <div class="farm-card__side">
        <button class="fav-btn" data-fav={farm.slug} aria-pressed="false" aria-label="Ajouter aux favoris">
          <Icon name="heart" size={18} />
        </button>
        <a href={href} class="voir">Voir</a>
      </div>
    </article>
  ) : (
    <article class="farm-tile print" style={`--off:${categoryById[farm.cats[0]].color}`} data-tile>
      <div class="farm-tile__cover" transition:name={vt}>
        <FarmCover farm={farm} variant="hero" />
      </div>
      <button class="fav-btn fav-btn--float" data-fav={farm.slug} aria-pressed="false" aria-label="Ajouter aux favoris">
        <Icon name="heart" size={18} />
      </button>
      <div class="farm-tile__body">
        <div class="farm-tile__row">
          <h3 class="farm-tile__name serif">
            <a href={href} class="farm-tile__link">{farm.name}</a>
          </h3>
          <span class="farm-tile__rating">
            <Icon name="star" size={15} class="star" /> {farm.rating.toFixed(1)}
          </span>
        </div>
        <p class="farm-tile__where">
          {farm.commune} · {farm.tagline}
        </p>
        <div class="farm-card__tags">
          {farm.cats.map((c) => (
            <span class="tag" style={`--c:${categoryById[c].tint}`}>
              {categoryById[c].short}
            </span>
          ))}
        </div>
      </div>
    </article>
  )
}

<style is:global>
  .farm-card {
    position: relative;
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 18px;
    align-items: center;
    padding: 16px 18px 16px 16px;
    border-radius: var(--r-l);
    box-shadow: var(--print-rest);
    cursor: pointer;
    transition:
      box-shadow 0.35s var(--ease),
      background 0.35s,
      transform 0.45s var(--ease);
    outline: none;
  }
  .farm-card:hover {
    transform: translate(-1px, -2px);
    box-shadow: var(--print-hover);
  }
  .farm-card.is-active,
  .farm-card:focus-visible {
    background-color: var(--cream-2);
    box-shadow: inset 0 0 0 2px var(--ink), 5px 6px 0 0 var(--off);
  }
  .farm-card__thumb {
    width: 96px;
    aspect-ratio: 1;
    border-radius: 16px;
    overflow: hidden;
    align-self: start;
  }
  .farm-card__thumb .cover-main {
    transition: transform 0.7s var(--ease);
    transform-origin: 200px 160px;
  }
  .farm-card:hover .cover-main {
    transform: rotate(-6deg) scale(1.06);
  }
  .farm-card__body {
    min-width: 0;
  }
  .farm-card__name {
    margin: 0 30px 4px 0;
    font-size: 20px;
    line-height: 1.08;
  }
  .farm-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  .farm-card__meta > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .farm-card .pin {
    color: var(--coral);
  }
  .star {
    color: #dba43a;
    fill: #f2c85a;
  }
  .muted {
    color: var(--muted);
  }
  .farm-card__status {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 1.4em;
  }
  .farm-card__status::before,
  .status-dot::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .farm-card__status.is-open,
  .status-dot.is-open {
    color: #235f3e;
  }
  .farm-card__status.is-open::before,
  .status-dot.is-open::before {
    background: #2f7a50;
    box-shadow: 0 0 0 3px rgba(47, 122, 80, 0.2);
  }
  .farm-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 10px;
  }
  .farm-card__tags .tag {
    height: 26px;
    padding: 0 10px;
    font-size: 12.5px;
    background: var(--c, var(--sand));
  }
  .farm-card__side {
    align-self: center;
  }
  .farm-card__side .fav-btn {
    position: absolute;
    top: 10px;
    right: 10px;
  }
  .voir {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--ctl-md);
    padding: 0 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    font-weight: 600;
    font-size: var(--fs-ctl);
    margin-top: 22px;
    transition:
      background 0.3s,
      color 0.3s,
      transform 0.4s var(--ease);
  }
  .voir:hover {
    background: var(--coral);
    color: var(--ink);
  }
  .fav-btn {
    display: grid;
    place-items: center;
    width: var(--ctl-sm);
    height: var(--ctl-sm);
    border-radius: 50%;
    color: var(--ink-2);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .fav-btn:hover {
    background: var(--sand);
    color: var(--ink);
  }
  .fav-btn[aria-pressed='true'] {
    color: var(--coral);
  }
  .fav-btn[aria-pressed='true'] svg {
    fill: var(--coral);
  }
  .fav-btn--float {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(252, 250, 242, 0.9);
    backdrop-filter: blur(6px);
  }
  .fav-burst {
    position: fixed;
    z-index: 200;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 50%;
    pointer-events: none;
  }

  /* Tuile */
  .farm-tile__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .farm-tile .fav-btn--float {
    z-index: 2;
  }
  .farm-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--r-l);
    box-shadow: var(--print-rest);
    overflow: hidden;
    transition:
      box-shadow 0.4s var(--ease),
      transform 0.5s var(--ease);
  }
  .farm-tile:hover {
    transform: translate(-3px, -6px);
    box-shadow: var(--print-hover);
  }
  .farm-tile__cover {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .farm-tile__cover .cover {
    transition: transform 0.9s var(--ease);
  }
  .farm-tile:hover .farm-tile__cover .cover {
    transform: scale(1.05);
  }
  .farm-tile__body {
    padding: 20px 22px 24px;
  }
  .farm-tile__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }
  .farm-tile__name {
    margin: 0;
    font-size: 23px;
    line-height: 1.08;
  }
  .farm-tile__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
    font-size: var(--fs-ctl);
  }
  .farm-tile__where {
    margin: 6px 0 0;
    color: var(--ink-2);
    font-size: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 560px) {
    .farm-card {
      grid-template-columns: 88px 1fr;
      gap: 14px;
      padding: 14px;
    }
    .farm-card__thumb {
      width: 88px;
      border-radius: 14px;
    }
    .farm-card__name {
      font-size: 20px;
    }
    .farm-card__side {
      grid-column: 1 / -1;
      display: flex;
    }
    .voir {
      flex: 1;
      height: 44px;
      margin-top: 0;
    }
  }
</style>

<script>
  import { initFavButtons } from '../lib/favs-ui';
  document.addEventListener('astro:page-load', initFavButtons);
</script>
