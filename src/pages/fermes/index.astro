  /* marqueurs : des pastilles imprimées, avec leur ombre d'encre décalée */
  .mk {
    width: 48px;
    height: 58px;
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0;
  }
  .mk__pin {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--c);
    box-shadow:
      0 0 0 3px var(--white),
      0 0 0 4.5px var(--ink),
      3px 4px 0 4.5px rgba(53, 34, 0, 0.85);
    transform-origin: 50% 120%;
    transition:
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s;
  }
  .mk__pin::after {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(100% + 2px);
    width: 0;
    height: 0;
    margin-left: -7px;
    border: 7px solid transparent;
    border-top: 9px solid var(--ink);
    border-bottom: 0;
