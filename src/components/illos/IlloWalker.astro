---
/**
 * Onboarding « Où êtes-vous ? » : une grande silhouette qui marche à longues enjambées,
 * le nez dans sa carte, vers une épingle géante plantée dans le pré.
 */
import { ink, shade, starPath } from '../../lib/riso';

const { class: cls, ...rest } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
const { brown: K, paper: W, blue: B, sky: S, orange: O, red: R, coral: C, yellow: Y, green: G, leaf: L, taupe: T } = ink;
---

<svg class:list={['illo', 'riso', cls]} viewBox="0 0 400 480" aria-hidden="true" {...rest}>
  <defs>
    <clipPath id={`walker-coat-${uid}`}><path d="M150 176 C 156 164 206 164 214 176 L 222 286 L 142 286 Z"></path></clipPath>
  </defs>

  <!-- colline et chemin -->
  <path d="M0 480 V 410 C 120 380 300 382 400 404 V 480 Z" fill={L}></path>
  <path d="M0 480 V 410 C 120 380 300 382 400 404 V 480 Z" {...shade('g', 'b')}></path>
  <path d="M60 480 C 120 444 250 432 400 436 V 452 C 260 450 150 460 112 480 Z" fill={Y}></path>

  <!-- épingle géante plantée -->
  <g class="ri-bob" style="--a:-8px; --dur:2.6s">
    <path d="M330 250 C 300 250 278 272 278 300 C 278 336 330 388 330 388 C 330 388 382 336 382 300 C 382 272 360 250 330 250 Z" fill={C}></path>
    <path d="M330 250 C 300 250 278 272 278 300 C 278 336 330 388 330 388 C 330 388 382 336 382 300 C 382 272 360 250 330 250 Z" {...shade('r', 'r')}></path>
    <circle cx="330" cy="298" r="18" fill={W}></circle>
  </g>
  <ellipse cx="330" cy="404" rx="26" ry="6" fill={G}></ellipse>
  <g transform="translate(372 216)">
    <path class="ri-spin" style="--dur:24s" d={starPath(0, 0, 16, 7, 8)} fill={Y}></path>
  </g>

  <!-- jambe arrière (enjambée) -->
  <path d="M152 278 L 182 286 L 120 446 L 96 438 Z" fill={B}></path>
  <path d="M152 278 L 182 286 L 120 446 L 96 438 Z" {...shade('k', 'l')}></path>
  <path d="M92 432 L 124 444 L 120 460 L 76 458 C 70 456 70 448 76 446 Z" fill={K}></path>

  <!-- jambe avant -->
  <path d="M176 280 L 210 280 L 248 446 L 220 452 Z" fill={B}></path>
  <path d="M176 280 L 210 280 L 248 446 L 220 452 Z" {...shade('b', 'r')}></path>
  <path d="M216 446 L 250 440 L 274 452 C 280 456 278 464 270 464 L 218 464 Z" fill={K}></path>

  <!-- manteau à rayures -->
  <path d="M150 176 C 156 164 206 164 214 176 L 222 286 L 142 286 Z" fill={O}></path>
  <g clip-path={`url(#walker-coat-${uid})`} fill={R}>
    <rect x="140" y="200" width="90" height="10"></rect>
    <rect x="140" y="228" width="90" height="10"></rect>
    <rect x="140" y="256" width="90" height="10"></rect>
  </g>
  <path d="M150 176 C 156 164 206 164 214 176 L 222 286 L 142 286 Z" {...shade('r', 'l')}></path>

  <!-- tête penchée sur la carte, casquette -->
  <rect x="176" y="134" width="15" height="36" rx="5" fill={T}></rect>
  <circle cx="186" cy="124" r="18" fill={T}></circle>
  <path d="M203 124 L 210 131 L 203 135 Z" fill={T}></path>
  <path d="M168 116 C 168 98 182 92 194 94 C 204 96 210 104 210 112 L 226 114 C 228 118 226 120 222 120 L 168 120 Z" fill={G}></path>
  <path d="M168 120 C 166 130 170 140 176 144 C 176 134 178 126 182 120 Z" fill={K}></path>

  <!-- carte dépliée -->
  <g class="ri-sway" style="--a:2.5deg; --dur:3.6s; --o:0% 60%">
    <path d="M214 170 L 254 160 L 290 172 L 290 236 L 254 226 L 214 236 Z" fill={W}></path>
    <path d="M254 160 L 290 172 L 290 236 L 254 226 Z" fill={S}></path>
    <path d="M214 170 L 254 160 L 254 226 L 214 236 Z" {...shade('k', 'l')}></path>
    <path d="M222 220 C 234 206 236 190 250 184 S 270 196 280 186" stroke={C} stroke-width="3.4" fill="none" stroke-dasharray="6 5" stroke-linecap="round"></path>
    <circle cx="280" cy="186" r="5" fill={C}></circle>
  </g>
  <path d="M206 188 L 222 210" stroke={O} stroke-width="22" stroke-linecap="round"></path>
  <circle cx="226" cy="214" r="10" fill={T}></circle>
</svg>
