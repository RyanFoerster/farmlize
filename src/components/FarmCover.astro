---
/**
 * Couverture illustrée d'une ferme, style risographie, générée à partir du slug (toujours la même pour une ferme).
 * Soleil rayé, collines en bandes, sillons, arbre bicolore, maison géométrique, et le produit phare au centre.
 */
import type { Farm } from '../data/farms';
import { categoryById } from '../data/categories';
import { ink, shade } from '../lib/riso';

interface Props {
  farm: Farm;
  class?: string;
  /** 'thumb' = produit principal en grand, 'hero' = paysage + produits */
  variant?: 'thumb' | 'hero';
}
const { farm, class: cls, variant = 'thumb' } = Astro.props;

let h = 2166136261;
for (const ch of farm.slug) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
let s = h >>> 0;
const rnd = () => {
  s = (s + 0x6d2b79f5) >>> 0;
  let t = s;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const r = (a: number, b: number) => a + rnd() * (b - a);
const pick = <T,>(arr: readonly T[]) => arr[Math.floor(rnd() * arr.length)];

const id = farm.slug;
const main = farm.cats[0];
const sky = categoryById[main].tint;

// jeux d'encres : chaque ferme a sa combinaison
const schemes = [
  { sun: ink.yellow, back: ink.blue, backLine: ink.sky, mid: ink.leaf, field: ink.green, furrow: ink.leaf },
  { sun: ink.orange, back: ink.green, backLine: ink.leaf, mid: ink.yellow, field: ink.blue, furrow: ink.sky },
  { sun: ink.coral, back: ink.blue, backLine: ink.sky, mid: ink.orange, field: ink.green, furrow: ink.leaf },
  { sun: ink.yellow, back: ink.green, backLine: ink.leaf, mid: ink.pink, field: ink.blue, furrow: ink.sky },
] as const;
const c = pick(schemes);

const sun = { x: r(70, 330), y: r(62, 92), r: r(30, 42) };
const backY = r(150, 175);
const back = `M-20 ${backY + 40} C 60 ${backY - 40}, 170 ${backY - 50}, 250 ${backY + 5} C 300 ${backY + 30}, 350 ${backY - 30}, 420 ${backY - 10} L420 320 L-20 320 Z`;
const midY = r(196, 214);
const mid = `M-20 ${midY} C 90 ${midY - 34}, 220 ${midY - 26}, 300 ${midY + 4} S 400 ${midY - 8}, 420 ${midY - 4} L420 320 L-20 320 Z`;
const fieldY = r(228, 244);
const field = `M-20 ${fieldY} C 120 ${fieldY - 22}, 280 ${fieldY - 22}, 420 ${fieldY + 4} L420 320 L-20 320 Z`;
const hasHouse = rnd() > 0.3;
const houseX = r(232, 300);
const treeX = r(46, 110);
const treeR = r(20, 28);
const extras = farm.cats.slice(1, 3);
---

<svg
  class:list={['cover', 'riso', `cover--${variant}`, cls]}
  viewBox="0 0 400 300"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label={`Illustration de ${farm.name}`}
>
  <defs>
    <clipPath id={`sun-${id}-${variant}`}><circle cx={sun.x} cy={sun.y} r={sun.r}></circle></clipPath>
  </defs>
  <rect width="400" height="300" fill={sky}></rect>

  <!-- soleil rayé, façon coucher de soleil -->
  <g class="cover-sun">
    <circle cx={sun.x} cy={sun.y} r={sun.r} fill={c.sun}></circle>
    <circle cx={sun.x} cy={sun.y} r={sun.r} {...shade('o', 'b')}></circle>
    <g clip-path={`url(#sun-${id}-${variant})`} fill={sky}>
      <rect x={sun.x - sun.r} y={sun.y + sun.r * 0.28} width={sun.r * 2} height={sun.r * 0.11}></rect>
      <rect x={sun.x - sun.r} y={sun.y + sun.r * 0.52} width={sun.r * 2} height={sun.r * 0.15}></rect>
      <rect x={sun.x - sun.r} y={sun.y + sun.r * 0.78} width={sun.r * 2} height={sun.r * 0.22}></rect>
    </g>
  </g>

  <!-- collines du fond, en bandes -->
  <path d={back} fill={c.back}></path>
  <g stroke={c.backLine} stroke-width="4" fill="none" opacity=".9">
    <path d={`M-20 ${backY + 30} C 60 ${backY - 30}, 170 ${backY - 40}, 250 ${backY + 14}`}></path>
    <path d={`M-20 ${backY + 48} C 70 ${backY - 6}, 170 ${backY - 14}, 250 ${backY + 34}`}></path>
  </g>
  <path d={back} {...shade('k', 'b')}></path>

  <!-- arbre bicolore -->
  <g class="cover-tree" transform={`translate(${treeX} ${midY - treeR * 2.1})`}>
    <rect x="-3" y={treeR * 0.6} width="6" height={treeR * 1.8} fill={ink.brown}></rect>
    <g class={variant === 'hero' ? 'ri-sway' : undefined} style="--a:2.5deg; --dur:6s">
      <path d={`M0 ${-treeR} A ${treeR} ${treeR} 0 0 0 0 ${treeR} Z`} fill={ink.green}></path>
      <path d={`M0 ${-treeR} A ${treeR} ${treeR} 0 0 1 0 ${treeR} Z`} fill={ink.leaf}></path>
      <circle cx={-treeR * 0.45} cy={-treeR * 0.15} r="3.4" fill={ink.orange}></circle>
      <circle cx={treeR * 0.4} cy={treeR * 0.3} r="3.4" fill={ink.red}></circle>
      <circle cx={treeR * 0.1} cy={-treeR * 0.55} r="3" fill={ink.yellow}></circle>
    </g>
  </g>

  <!-- maison -->
  {
    hasHouse && (
      <g class="cover-house" transform={`translate(${houseX} ${midY - 44})`}>
        <rect x="0" y="16" width="44" height="30" fill={ink.orange} />
        <rect x="0" y="16" width="44" height="30" {...shade('r', 'r')} />
        <path d="M-5 18 L22 -6 L49 18 Z" fill={ink.red} />
        <g stroke={ink.paper} stroke-width="2.4">
          <path d="M8 13 L22 0" />
          <path d="M14 17 L28 4" />
        </g>
        <path d="M16 46 V34 A6 6 0 0 1 28 34 V46 Z" fill={ink.brown} />
        <rect x="32" y="24" width="7" height="7" fill={ink.paper} />
      </g>
    )
  }

  <path d={mid} fill={c.mid}></path>
  <path d={mid} {...shade('k', 'b')}></path>

  <!-- champ et sillons -->
  <path d={field} fill={c.field}></path>
  <g stroke={c.furrow} stroke-width="3.5" fill="none" stroke-linecap="round" opacity=".85">
    <path d={`M10 ${fieldY + 20} C 140 ${fieldY + 4}, 270 ${fieldY + 6}, 390 ${fieldY + 24}`}></path>
    <path d={`M-10 ${fieldY + 40} C 140 ${fieldY + 24}, 270 ${fieldY + 26}, 410 ${fieldY + 44}`}></path>
  </g>
  <path d={field} {...shade('k', 'b')}></path>

  {
    variant === 'thumb' ? (
      <use class="cover-main" href={`#ico-${main}`} x="125" y="88" width="150" height="150" />
    ) : (
      <g>
        <use class="cover-main" href={`#ico-${main}`} x="140" y="114" width="124" height="124" />
        {extras.map((cat, i) => (
          <use class="cover-extra" href={`#ico-${cat}`} x={i === 0 ? 264 : 80} y="214" width="60" height="60" />
        ))}
      </g>
    )
  }
</svg>

<style>
  .cover {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
