</style>

<script>
  import * as maplibregl from 'maplibre-gl';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
  import { Flip } from 'gsap/Flip';
  import { gsap, onPage, reduced } from '../../lib/motion';
  import { farms, farmBySlug, type Farm } from '../../data/farms';
  import { categories, categoryById, type CategoryId } from '../../data/categories';
  import { communeBySlug, DEFAULT_COMMUNE, type Commune } from '../../data/communes';
  import { distanceKm, formatKm, normalize, openStatus, searchCommunes, nearestCommune } from '../../lib/geo';
  import { getFavs, getPrefs, setPrefs } from '../../lib/store';
  import { farmlizeStyle, circle } from '../../lib/map-style';

  gsap.registerPlugin(Flip);
  maplibregl.setWorkerUrl(workerUrl);

  const VIEW_KEY = 'farmlize:explore-view';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const closeSvg =
    '<svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6"/></svg>';
  const starSvg =
    '<svg class="icon star" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L12 3.5Z"/></svg>';

  onPage('[data-explore]', (root) => {
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
    const offs: (() => void)[] = [];
    const on = (el: EventTarget, ev: string, fn: (e: any) => void, opts?: AddEventListenerOptions) => {
      el.addEventListener(ev, fn, opts);
      offs.push(() => el.removeEventListener(ev, fn, opts));
    };

    // ---------- état ----------
    const params = new URLSearchParams(location.search);
    const prefs = getPrefs();
    const hasUrl = params.has('lieu') || params.has('cats');
    const state = {
      commune: communeBySlug[params.get('lieu') ?? prefs.commune ?? DEFAULT_COMMUNE] ?? communeBySlug[DEFAULT_COMMUNE],
      cats: new Set<CategoryId>(
        ((params.get('cats') ?? (hasUrl ? '' : (prefs.cats ?? []).join(','))) as string)
          .split(',')
          .filter((c): c is CategoryId => c in categoryById),
      ),
      radius: params.has('r') ? Number(params.get('r')) : 25,
      open: params.get('ouvert') === '1',
      favs: params.has('favoris'),
      q: params.get('q') ?? '',
      labels: new Set((params.get('labels') ?? '').split(',').filter(Boolean)),
      sort: (params.get('tri') as 'distance' | 'note' | 'nom') ?? 'distance',
      selected: null as string | null,
    };

    const panel = $('[data-panel]');
    const list = $('[data-list]');
    const cards = $$<HTMLElement>('[data-farm-card]');
    const cardBySlug = new Map(cards.map((c) => [c.dataset.slug!, c]));
    const dist = new Map<string, number>();
    let visible: Farm[] = [];

    // ---------- calculs ----------
    const computeDistances = () => {
      for (const f of farms) dist.set(f.slug, distanceKm(state.commune, f));
      cards.forEach((card) => {
        const d = dist.get(card.dataset.slug!)!;
        card.querySelector('[data-distance]')!.textContent = formatKm(d);
      });
    };
    const statuses = new Map(farms.map((f) => [f.slug, openStatus(f.hours)]));
    cards.forEach((card) => {
      const s = statuses.get(card.dataset.slug!)!;
      const el = card.querySelector<HTMLElement>('[data-status]')!;
      el.textContent = s.label;
      el.classList.toggle('is-open', s.open);
    });

    const matches = (f: Farm) => {
      const favs = getFavs();
      if (state.favs) return favs.includes(f.slug);
      if (state.cats.size && !f.cats.some((c) => state.cats.has(c))) return false;
      if (state.radius && dist.get(f.slug)! > state.radius) return false;
      if (state.open && !statuses.get(f.slug)!.open) return false;
      for (const l of state.labels) if (!f.labels.includes(l)) return false;
      if (state.q) {
        const hay = normalize(cardBySlug.get(f.slug)!.dataset.search!);
        if (!normalize(state.q).split(' ').every((w) => hay.includes(w))) return false;
      }
      return true;
    };

    const sortFn = (a: Farm, b: Farm) =>
      state.sort === 'note'
        ? b.rating - a.rating || dist.get(a.slug)! - dist.get(b.slug)!
        : state.sort === 'nom'
          ? a.name.localeCompare(b.name, 'fr')
          : dist.get(a.slug)! - dist.get(b.slug)!;

    // ---------- UI : chips, compteurs, URL ----------
    const radiusLabel = (r: number) => (r ? `< ${r} km` : 'Toute la Belgique');
    const renderChips = () => {
      const wrap = $('[data-cat-chips]');
      wrap.innerHTML = [...state.cats]
        .map((c) => `<button type="button" class="chip chip-cat" data-remove-cat="${c}">${esc(categoryById[c].label)} ${closeSvg}</button>`)
        .join('');
      $('[data-radius-label]').textContent = radiusLabel(state.radius);
      $$('[data-radius]').forEach((li) => li.setAttribute('aria-selected', String(Number(li.dataset.radius) === state.radius)));
      $('[data-open-chip]').setAttribute('aria-pressed', String(state.open));
      $('[data-fav-toggle]').setAttribute('aria-pressed', String(state.favs));
      $$('[data-cat-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(state.cats.has(b.dataset.catToggle as CategoryId))));
      $$('[data-label-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(state.labels.has(b.dataset.labelToggle!))));
      $$('[data-sort-opt]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sortOpt === state.sort)));
      $('[data-sort-label]').textContent = state.sort;
      const range = $<HTMLInputElement>('[data-range]');
      range.value = String(state.radius || 120);
      $('[data-range-label]').textContent = state.radius ? `${state.radius} km` : 'toute la Belgique';
      const extra = state.labels.size + (state.sort !== 'distance' ? 1 : 0) + state.cats.size;
      const badge = $('[data-filter-badge]');
      badge.hidden = !extra;
      badge.textContent = String(extra);
      $('[data-head-label]').textContent = state.favs ? 'Mes fermes favorites' : state.q ? 'Résultats' : 'Fermes à proximité';
      const favCount = getFavs().length;
      $('[data-fav-count]').textContent = String(favCount);
      $('[data-fav-toggle]').classList.toggle('has-favs', favCount > 0);
    };

    const syncUrl = () => {
      const p = new URLSearchParams();
      p.set('lieu', state.commune.slug);
      if (state.cats.size) p.set('cats', [...state.cats].join(','));
      if (state.radius !== 25) p.set('r', String(state.radius));
      if (state.open) p.set('ouvert', '1');
      if (state.favs) p.set('favoris', '1');
      if (state.q) p.set('q', state.q);
      if (state.labels.size) p.set('labels', [...state.labels].join(','));
      if (state.sort !== 'distance') p.set('tri', state.sort);
      history.replaceState(history.state, '', `${location.pathname}?${p}`);
      setPrefs({ commune: state.commune.slug, cats: [...state.cats] });
    };

    // ---------- liste (Flip) ----------
    let first = true;
    const apply = (opts: { fit?: boolean } = {}) => {
      visible = farms.filter(matches).sort(sortFn);
      const ids = new Set(visible.map((f) => f.slug));
      const flipState = first || reduced() ? null : Flip.getState(cards);

      cards.forEach((c) => (c.style.display = ids.has(c.dataset.slug!) ? '' : 'none'));
      visible.forEach((f) => list.appendChild(cardBySlug.get(f.slug)!));

      if (flipState) {
        Flip.from(flipState, {
          duration: 0.6,
          ease: 'fz.inOut',
          absolute: true,
          scale: false,
          onEnter: (els) => gsap.fromTo(els, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.55, stagger: 0.04, delay: 0.1 }),
          onLeave: (els) => gsap.to(els, { autoAlpha: 0, scale: 0.96, duration: 0.3 }),
        });
      } else if (first && !reduced()) {
        gsap.fromTo(
          visible.slice(0, 6).map((f) => cardBySlug.get(f.slug)!),
          { autoAlpha: 0, y: 30 },
          { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.07, delay: 0.15 },
        );
      }
      first = false;

      // compteur animé
      const countEl = $('[data-count]');
      const from = { v: Number(countEl.textContent) || 0 };
      gsap.to(from, { v: visible.length, duration: 0.5, ease: 'power2.out', onUpdate: () => (countEl.textContent = String(Math.round(from.v))) });
      $('[data-drawer-count]').textContent = String(visible.length);
      // sous l'étiquette du lieu : combien de fermes, dans quel rayon
      const n = visible.length;
      $('[data-map-sub]').textContent = state.favs
        ? `${n} favorite${n > 1 ? 's' : ''}`
        : `${n} ferme${n > 1 ? 's' : ''} · ${state.radius ? `moins de ${state.radius} km` : 'toute la Belgique'}`;

      // état vide
      const empty = $('[data-empty]');
      empty.hidden = visible.length > 0;
      if (!visible.length) {
        $('[data-empty-text]').textContent = state.favs
          ? 'Vous n’avez pas encore de ferme favorite. Touchez le cœur d’une ferme pour la retrouver ici.'
          : 'Aucune ferme ne correspond à vos critères dans ce rayon.';
        $('[data-widen]').hidden = state.favs || state.radius === 0;
        if (!reduced()) gsap.fromTo(empty, { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.6 });
      }

      renderChips();
      syncUrl();
      updateMarkers(opts.fit ?? true);
    };

    // ---------- carte ----------
    let map: maplibregl.Map | null = null;
    let popup: maplibregl.Popup | null = null;
    let me: maplibregl.Marker | null = null;
    const markers = new Map<string, { marker: maplibregl.Marker; el: HTMLElement }>();
    const radiusAnim = { r: state.radius || 0 };

    const setRadiusShape = () => {
      const src = map?.getSource('radius') as maplibregl.GeoJSONSource | undefined;
      if (!src) return;
      src.setData(circle(state.commune.lng, state.commune.lat, Math.max(radiusAnim.r, 0.01)) as any);
    };

    const fitView = (animate = true) => {
      if (!map) return;
      const pad = matchMedia('(max-width: 900px)').matches ? 40 : 70;
      const b = new maplibregl.LngLatBounds();
      if (state.favs || !state.radius) {
        visible.forEach((f) => b.extend([f.lng, f.lat]));
        b.extend([state.commune.lng, state.commune.lat]);
        if (!visible.length) return map.flyTo({ center: [state.commune.lng, state.commune.lat], zoom: 8 });
      } else {
        const ring = circle(state.commune.lng, state.commune.lat, state.radius).features[0].geometry.coordinates[0];
        ring.forEach((c) => b.extend(c as [number, number]));
      }
      map.fitBounds(b, { padding: pad, duration: animate && !reduced() ? 1400 : 0, maxZoom: 13, essential: true });
    };

    const updateMarkers = (fit: boolean) => {
      if (!map) return;
      const ids = new Set(visible.map((f) => f.slug));
      markers.forEach(({ el }, slug) => {
        const show = ids.has(slug);
        const pin = el.querySelector('.mk__pin')!;
        if (show && el.dataset.shown !== '1') {
          el.style.display = '';
          gsap.fromTo(pin, { scale: 0, y: -20 }, { scale: 1, y: 0, duration: 0.6, ease: 'back.out(2.2)', delay: Math.random() * 0.25, clearProps: 'transform' });
        } else if (!show && el.dataset.shown === '1') {
          gsap.to(pin, { scale: 0, duration: 0.25, ease: 'power2.in', onComplete: () => (el.style.display = 'none'), clearProps: 'transform' });
        }
        el.dataset.shown = show ? '1' : '0';
      });
      if (state.selected && !ids.has(state.selected)) select(null);
      gsap.to(radiusAnim, { r: state.favs ? 0 : state.radius, duration: reduced() ? 0 : 0.9, ease: 'fz.inOut', onUpdate: setRadiusShape });
      if (fit) fitView();
    };

    const placeMe = () => {
      if (!map) return;
      if (!me) {
        const el = document.createElement('div');
        el.className = 'me';
        el.innerHTML = '<span>Vous êtes ici</span>';
        me = new maplibregl.Marker({ element: el }).setLngLat([state.commune.lng, state.commune.lat]).addTo(map);
      } else me.setLngLat([state.commune.lng, state.commune.lat]);
    };

    const popupHtml = (f: Farm) => {
      const s = statuses.get(f.slug)!;
      const cover = cardBySlug.get(f.slug)!.querySelector('.cover')!.outerHTML;
      return `<a class="pop" href="/fermes/${f.slug}">
        <span class="pop__thumb">${cover}</span>
        <span>
          <p class="pop__name">${esc(f.name)}</p>
          <p class="pop__meta">${starSvg} ${f.rating.toFixed(1).replace('.', ',')} (${f.reviews}) · ${formatKm(dist.get(f.slug)!)}</p>
          <p class="pop__status ${s.open ? 'is-open' : ''}">${esc(s.label)}</p>
          <span class="pop__link">Voir la ferme →</span>
        </span>
      </a>`;
    };

    function select(slug: string | null, opts: { fly?: boolean; scroll?: boolean } = {}) {
      state.selected = slug;
      cards.forEach((c) => c.classList.toggle('is-active', c.dataset.slug === slug));
      markers.forEach(({ el }, s) => {
        el.classList.toggle('is-active', s === slug);
        el.parentElement && (el.style.zIndex = s === slug ? '5' : '');
      });
      popup?.remove();
      popup = null;
      if (!slug || !map) return;
      const f = farmBySlug[slug];
      popup = new maplibregl.Popup({ closeButton: false, offset: [0, -64], className: 'fz-popup', maxWidth: 'none', anchor: 'bottom' })
        .setLngLat([f.lng, f.lat])
        .setHTML(popupHtml(f))
        .addTo(map);
      const content = popup.getElement()?.querySelector('.maplibregl-popup-content');
      if (content && !reduced()) gsap.fromTo(content, { y: 14, scale: 0.92, autoAlpha: 0 }, { y: 0, scale: 1, autoAlpha: 1, duration: 0.55, ease: 'back.out(1.8)' });
      if (opts.fly !== false) {
        map.easeTo({ center: [f.lng, f.lat], zoom: Math.max(map.getZoom(), 11.5), duration: reduced() ? 0 : 900, offset: [0, 80] });
      }
      if (opts.scroll) {
        const card = cardBySlug.get(slug)!;
        const top = card.offsetTop - 120;
        panel.scrollTo({ top, behavior: reduced() ? 'auto' : 'smooth' });
      }
    }

    const initMap = async () => {
      const container = $('[data-map]');
      let style: any;
      try {
        style = await farmlizeStyle();
      } catch {
        style = { version: 8, sources: {}, layers: [{ id: 'bg', type: 'background', paint: { 'background-color': '#F1ECDF' } }] };
      }
      if (!root.isConnected) return;
      const saved = (() => {
        try {
          const v = JSON.parse(sessionStorage.getItem(VIEW_KEY) || 'null');
          return v && v.search === location.search ? v : null;
        } catch {
          return null;
        }
      })();
      map = new maplibregl.Map({
        container,
        style,
        center: saved?.center ?? [state.commune.lng, state.commune.lat],
        zoom: saved?.zoom ?? 9.5,
        attributionControl: { compact: true },
        dragRotate: true,
        pitchWithRotate: false,
        fadeDuration: 200,
      });
      map.on('load', () => {
        if (!map) return;
        gsap.to($('[data-map-loading]'), { autoAlpha: 0, duration: 0.5 });
        map.addSource('radius', { type: 'geojson', data: circle(state.commune.lng, state.commune.lat, 0.01) as any });
        map.addLayer({ id: 'radius-fill', type: 'fill', source: 'radius', paint: { 'fill-color': '#E9694F', 'fill-opacity': 0.08 } });
        map.addLayer({
          id: 'radius-line',
          type: 'line',
          source: 'radius',
          layout: { 'line-cap': 'round' },
          paint: { 'line-color': '#E9694F', 'line-width': 2.5, 'line-dasharray': [0.1, 2.2] },
        });

        for (const f of farms) {
          const el = document.createElement('button');
          el.type = 'button';
          el.className = 'mk';
          el.style.setProperty('--c', categoryById[f.cats[0]].color);
          el.setAttribute('aria-label', f.name);
          el.innerHTML = `<span class="mk__pin"><svg class="riso" viewBox="0 0 100 100" aria-hidden="true"><use href="#ico-${f.cats[0]}"></use></svg></span>`;
          el.style.display = 'none';
          el.dataset.shown = '0';
          el.addEventListener('click', (e) => {
            e.stopPropagation();
            select(f.slug, { scroll: true });
          });
          el.addEventListener('mouseenter', () => cardBySlug.get(f.slug)?.classList.add('is-hover'));
          el.addEventListener('mouseleave', () => cardBySlug.get(f.slug)?.classList.remove('is-hover'));
          const marker = new maplibregl.Marker({ element: el, anchor: 'bottom' }).setLngLat([f.lng, f.lat]).addTo(map);
          markers.set(f.slug, { marker, el });
        }
        placeMe();
        updateMarkers(!saved);
        if (saved?.selected && visible.some((f) => f.slug === saved.selected)) select(saved.selected, { fly: false, scroll: false });
        if (saved?.scroll) panel.scrollTop = saved.scroll;
      });
      map.on('click', () => select(null));
      // l'aiguille suit la carte avec un petit rebond, comme une vraie boussole
      const rose = $('[data-compass-rose]');
      gsap.set(rose, { svgOrigin: '40 40' });
      map.on('rotate', () => {
        gsap.to(rose, { rotation: -map!.getBearing(), duration: reduced() ? 0 : 0.7, ease: 'elastic.out(1, 0.45)', overwrite: 'auto' });
      });
    };

    // ---------- interactions ----------
    cards.forEach((card) => {
      const slug = card.dataset.slug!;
      on(card, 'mouseenter', () => markers.get(slug)?.el.classList.add('is-hover'));
      on(card, 'mouseleave', () => markers.get(slug)?.el.classList.remove('is-hover'));
      on(card, 'click', (e: MouseEvent) => {
        if ((e.target as HTMLElement).closest('a, button')) return;
        select(slug);
        if (matchMedia('(max-width: 900px)').matches) setView(true);
      });
      on(card, 'keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' && e.target === card) select(slug);
      });
    });

    on(root, 'click', (e: MouseEvent) => {
      const rm = (e.target as HTMLElement).closest<HTMLElement>('[data-remove-cat]');
      if (rm) {
        state.cats.delete(rm.dataset.removeCat as CategoryId);
        gsap.to(rm, { scale: 0.6, autoAlpha: 0, duration: 0.2, onComplete: () => apply() });
      }
    });

    // rayon
    const radiusBtn = $('[data-radius-btn]');
    const radiusPop = $('[data-radius-pop]');
    const toggleRadius = (open: boolean) => {
      radiusPop.hidden = !open;
      radiusBtn.setAttribute('aria-expanded', String(open));
      if (open && !reduced()) gsap.fromTo(radiusPop, { autoAlpha: 0, y: -8, scale: 0.97 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.35, transformOrigin: 'top left' });
    };
    on(radiusBtn, 'click', (e: MouseEvent) => {
      e.stopPropagation();
      toggleRadius(radiusPop.hidden);
    });
    $$('[data-radius]').forEach((li) =>
      on(li, 'click', () => {
        state.radius = Number(li.dataset.radius);
        state.favs = false;
        toggleRadius(false);
        apply();
      }),
    );
    on(document, 'click', (e: MouseEvent) => {
      if (!(e.target as HTMLElement).closest('.ex-radius')) toggleRadius(false);
      if (!(e.target as HTMLElement).closest('[data-where-wrap]')) closeWhere();
    });

    on($('[data-open-chip]'), 'click', () => {
      state.open = !state.open;
      apply({ fit: false });
    });
    on($('[data-fav-toggle]'), 'click', () => {
      state.favs = !state.favs;
      apply();
    });
    on(window, 'fz:favs', () => {
      renderChips();
      if (state.favs) apply({ fit: false });
    });

    // recherche texte
    let qTimer = 0;
    const qInput = $<HTMLInputElement>('[data-q]');
    qInput.value = state.q;
    on(qInput, 'input', () => {
      clearTimeout(qTimer);
      qTimer = window.setTimeout(() => {
        state.q = qInput.value.trim();
        if (state.q) state.radius = state.radius && state.radius < 50 ? state.radius : state.radius;
        apply({ fit: false });
      }, 160);
    });

    // commune
    const whereInput = $<HTMLInputElement>('[data-where]');
    const whereList = $('[data-where-list]');
    let whereResults: Commune[] = [];
    let whereActive = 0;
    whereInput.value = state.commune.name;
    const closeWhere = () => {
      whereList.hidden = true;
      whereInput.setAttribute('aria-expanded', 'false');
    };
    const renderWhere = () => {
      whereResults = searchCommunes(whereInput.value);
      if (!whereResults.length) return closeWhere();
      whereList.innerHTML = whereResults
        .map((c, i) => `<li role="option" data-slug="${c.slug}" aria-selected="${i === whereActive}">${esc(c.name)} <span>· ${esc(c.province)} (${c.zip})</span></li>`)
        .join('');
      whereList.hidden = false;
      whereInput.setAttribute('aria-expanded', 'true');
    };
    const setCommune = (c: Commune) => {
      state.commune = c;
      whereInput.value = c.name;
      closeWhere();
      whereInput.blur();
      state.favs = false;
      computeDistances();
      placeMe();
      setLabel();
      select(null);
      apply();
    };
    on(whereInput, 'focus', () => whereInput.select());
    on(whereInput, 'input', () => {
      whereActive = 0;
      renderWhere();
    });
    on(whereInput, 'keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        whereActive = (whereActive + (e.key === 'ArrowDown' ? 1 : -1) + whereResults.length) % Math.max(whereResults.length, 1);
        renderWhere();
      } else if (e.key === 'Enter' && whereResults[whereActive]) setCommune(whereResults[whereActive]);
      else if (e.key === 'Escape') {
        whereInput.value = state.commune.name;
        closeWhere();
      }
    });
    on(whereInput, 'blur', () => setTimeout(() => !whereList.matches(':hover') && (whereInput.value = state.commune.name), 150));
    on(whereList, 'pointerdown', (e: PointerEvent) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-slug]');
      if (li) {
        e.preventDefault();
        setCommune(communeBySlug[li.dataset.slug!]);
      }
    });
    on($('[data-locate]'), 'click', () => {
      const btn = $('[data-locate]');
      btn.classList.add('is-loading');
      navigator.geolocation?.getCurrentPosition(
        (p) => {
          btn.classList.remove('is-loading');
          const c = nearestCommune(p.coords.latitude, p.coords.longitude);
          if (distanceKm({ lat: p.coords.latitude, lng: p.coords.longitude }, c) < 60) setCommune(c);
        },
        () => btn.classList.remove('is-loading'),
        { timeout: 10000 },
      );
    });

    // libellé de carte : l'étiquette se soulève, change de nom et se re-tamponne
    const label = $('[data-map-label]');
    const stamp = $('[data-map-stamp]');
    const setLabel = () => {
      const text = state.commune.name;
      if (reduced() || !label.textContent) return void (label.textContent = text);
      gsap
        .timeline()
        .to(stamp, { y: -14, rotation: -7, scale: 1.08, duration: 0.22, ease: 'power2.out', onComplete: () => void (label.textContent = text) })
        .to(stamp, { y: 0, rotation: 0, scale: 1, duration: 0.75, ease: 'back.out(3.2)' });
    };
    label.textContent = state.commune.name;

    // tiroir filtres
    const drawer = $('[data-drawer]');
    const sheet = drawer.querySelector<HTMLElement>('.ex-drawer__sheet')!;
    const openDrawer = (open: boolean) => {
      if (open) {
        drawer.hidden = false;
        if (reduced()) return;
        gsap.fromTo(drawer.querySelector('.ex-drawer__backdrop'), { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.4 });
        gsap.fromTo(sheet, { xPercent: -105 }, { xPercent: 0, duration: 0.7, ease: 'fz.out' });
        gsap.fromTo(sheet.querySelectorAll('fieldset'), { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.06, delay: 0.15 });
      } else {
        if (reduced()) return void (drawer.hidden = true);
        gsap.to(drawer.querySelector('.ex-drawer__backdrop'), { autoAlpha: 0, duration: 0.3 });
        gsap.to(sheet, { xPercent: -105, duration: 0.45, ease: 'power3.in', onComplete: () => (drawer.hidden = true) });
      }
    };
    on($('[data-open-filters]'), 'click', () => openDrawer(true));
    $$('[data-close-filters]').forEach((b) => on(b, 'click', () => openDrawer(false)));
    on(document, 'keydown', (e: KeyboardEvent) => e.key === 'Escape' && !drawer.hidden && openDrawer(false));
    $$('[data-cat-toggle]').forEach((b) =>
      on(b, 'click', () => {
        const id = b.dataset.catToggle as CategoryId;
        state.cats.has(id) ? state.cats.delete(id) : state.cats.add(id);
        gsap.fromTo(b.querySelector('svg'), { rotation: -14, scale: 0.8 }, { rotation: 0, scale: 1, duration: 0.6, ease: 'back.out(3)' });
        apply();
      }),
    );
    $$('[data-label-toggle]').forEach((b) =>
      on(b, 'click', () => {
        const l = b.dataset.labelToggle!;
        state.labels.has(l) ? state.labels.delete(l) : state.labels.add(l);
        apply({ fit: false });
      }),
    );
    $$('[data-sort-opt]').forEach((b) =>
      on(b, 'click', () => {
        state.sort = b.dataset.sortOpt as typeof state.sort;
        apply({ fit: false });
      }),
    );
    on($('[data-sort]'), 'click', () => {
      state.sort = state.sort === 'distance' ? 'note' : state.sort === 'note' ? 'nom' : 'distance';
      apply({ fit: false });
    });
    const range = $<HTMLInputElement>('[data-range]');
    on(range, 'input', () => {
      const v = Number(range.value);
      state.radius = v >= 120 ? 0 : v;
      state.favs = false;
      $('[data-range-label]').textContent = state.radius ? `${state.radius} km` : 'toute la Belgique';
    });
    on(range, 'change', () => apply());
    const reset = () => {
      state.cats.clear();
      state.labels.clear();
      state.open = false;
      state.favs = false;
      state.q = '';
      qInput.value = '';
      state.radius = 25;
      state.sort = 'distance';
      apply();
    };
    $$('[data-reset]').forEach((b) => on(b, 'click', reset));
    on($('[data-widen]'), 'click', () => {
      state.radius = state.radius === 10 ? 25 : state.radius === 25 ? 50 : 0;
      apply();
    });

    // carte : contrôles
    on($('[data-zoom-in]'), 'click', () => map?.zoomIn());
    on($('[data-zoom-out]'), 'click', () => map?.zoomOut());
    on($('[data-recenter]'), 'click', () => {
      select(null);
      fitView();
    });
    on($('[data-compass]'), 'click', () => map?.easeTo({ bearing: 0, pitch: 0, duration: 800 }));
    // « Recentrer » : l'icône fait un tour
    on($('[data-recenter]'), 'click', () => {
      if (!reduced()) gsap.fromTo($('[data-recenter] .icon'), { rotation: 0 }, { rotation: 360, duration: 0.8, ease: 'back.out(1.6)' });
    });

    // entrée : la carte se pose, puis le scotch, l'étiquette et les commandes arrivent d'un bond
    if (!reduced()) {
      gsap.from('[data-map-card]', { y: 30, rotation: -1.2, scale: 0.97, autoAlpha: 0, duration: 1, ease: 'back.out(1.4)', delay: 0.1 });
      gsap.from($$('[data-map-deco]'), {
        scale: 0,
        rotation: (i: number) => (i % 2 ? 24 : -24),
        duration: 0.8,
        ease: 'back.out(2.6)',
        stagger: 0.07,
        delay: 0.45,
        clearProps: 'transform',
      });
    }

    // vue mobile
    const setView = (mapView: boolean) => {
      root.classList.toggle('is-map', mapView);
      map?.resize();
      if (mapView && !reduced()) gsap.fromTo('.ex-map', { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.4, clearProps: 'visibility,opacity' });
    };
    on($('[data-view-toggle]'), 'click', () => setView(!root.classList.contains('is-map')));

    // ---------- démarrage ----------
    computeDistances();
    apply({ fit: false });
    initMap();

    return () => {
      // mémorise la vue pour le retour arrière
      try {
        if (map)
          sessionStorage.setItem(
            VIEW_KEY,
            JSON.stringify({ search: location.search, center: map.getCenter().toArray(), zoom: map.getZoom(), scroll: panel.scrollTop, selected: state.selected }),
          );
      } catch {}
      offs.forEach((o) => o());
      popup?.remove();
      map?.remove();
      map = null;
    };
  });
</script>
