---
/**
 * Le producteur : grandes jambes, bras démesurés qui brandissent une cagette pleine,
 * chapeau de paille. Les fanes de la cagette bougent à peine.
 */
import { ink, shade, starPath } from '../../lib/riso';

const { class: cls, ...rest } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
const { brown: K, paper: W, blue: B, sky: S, orange: O, red: R, coral: C, pink: P, yellow: Y, green: G, leaf: L, taupe: T } = ink;
---

<svg class:list={['illo', 'riso', cls]} viewBox="0 0 400 560" aria-hidden="true" {...rest}>
  <defs>
    <clipPath id={`farmer-shirt-${uid}`}><path d="M162 226 C 170 214 236 214 244 226 L 250 330 L 156 330 Z"></path></clipPath>
  </defs>

  <g transform="translate(60 250)"><path class="ri-spin" style="--dur:26s" d={starPath(0, 0, 18, 8, 8)} fill={Y}></path></g>
  <g transform="translate(346 300)"><path class="ri-spin" style="--dur:34s; --d:-6s" d={starPath(0, 0, 12, 5, 8)} fill={C}></path></g>

  <!-- sol -->
  <path d="M0 560 V 530 C 110 512 290 512 400 528 V 560 Z" fill={G}></path>
  <g stroke={L} stroke-width="5" stroke-linecap="round"><path d="M40 546 h44"></path><path d="M300 544 h52"></path></g>

  <!-- jambes en compas -->
  <path d="M168 318 L 204 322 L 166 526 L 136 522 Z" fill={B}></path>
  <path d="M168 318 L 204 322 L 166 526 L 136 522 Z" {...shade('k', 'l')}></path>
  <path d="M206 322 L 240 318 L 270 522 L 240 526 Z" fill={B}></path>
  <path d="M206 322 L 240 318 L 270 522 L 240 526 Z" {...shade('b', 'r')}></path>
  <path d="M132 516 H 168 L 170 538 H 112 C 104 538 104 528 112 524 Z" fill={K}></path>
  <path d="M238 516 H 272 L 292 524 C 300 528 300 538 292 538 H 236 Z" fill={K}></path>

  <!-- chemise à carreaux larges + salopette -->
  <path d="M162 226 C 170 214 236 214 244 226 L 250 330 L 156 330 Z" fill={R}></path>
  <g clip-path={`url(#farmer-shirt-${uid})`}>
    <g fill={C}><rect x="150" y="240" width="110" height="14"></rect><rect x="150" y="276" width="110" height="14"></rect></g>
    <g fill={O} opacity=".9"><rect x="176" y="210" width="12" height="130"></rect><rect x="216" y="210" width="12" height="130"></rect></g>
  </g>
  <path d="M178 262 H 228 L 238 332 H 168 Z" fill={G}></path>
  <path d="M178 262 H 228 L 238 332 H 168 Z" {...shade('k', 'b')}></path>
  <path d="M182 262 L 172 226 M 224 262 L 234 226" stroke={G} stroke-width="8" stroke-linecap="round"></path>
  <circle cx="186" cy="272" r="4" fill={Y}></circle><circle cx="220" cy="272" r="4" fill={Y}></circle>

  <!-- tête et chapeau -->
  <rect x="196" y="184" width="15" height="36" rx="5" fill={T}></rect>
  <circle cx="204" cy="174" r="18" fill={T}></circle>
  <ellipse cx="204" cy="160" rx="44" ry="9" fill={Y}></ellipse>
  <path d="M182 160 C 182 136 226 136 226 160 Z" fill={Y}></path>
  <path d="M182 158 C 182 136 226 136 226 158 Z" {...shade('o', 'r')}></path>
  <rect x="183" y="150" width="42" height="7" fill={R}></rect>

  <!-- bras démesurés qui brandissent la cagette -->
  <g stroke-linecap="round" fill="none">
    <path d="M168 232 L 132 168" stroke={R} stroke-width="26"></path>
    <path d="M132 168 L 120 112" stroke={T} stroke-width="19"></path>
    <path d="M238 232 L 276 168" stroke={R} stroke-width="26"></path>
    <path d="M276 168 L 288 112" stroke={T} stroke-width="19"></path>
  </g>

  <!-- cagette -->
  <g class="ri-bob" style="--a:-4px; --dur:3s">
    <g class="ri-sway" style="--a:3deg; --dur:4s">
      <path d="M140 64 C 132 40 136 20 148 10 C 154 30 152 50 140 64 Z" fill={G}></path>
      <path d="M146 64 C 156 44 172 34 188 34 C 180 50 166 62 146 64 Z" fill={L}></path>
    </g>
    <circle cx="190" cy="66" r="22" fill={C}></circle>
    <circle cx="190" cy="66" r="22" {...shade('r', 'd')}></circle>
    <circle cx="236" cy="62" r="26" fill={L}></circle>
    <path d="M216 52 C 228 60 244 60 256 52 M 214 68 C 228 76 244 76 258 68" stroke={G} stroke-width="4" fill="none"></path>
    <circle cx="236" cy="62" r="26" {...shade('g', 'b')}></circle>
    <g class="ri-sway" style="--a:4deg; --dur:3.4s; --d:-1s">
      <path d="M272 70 L 300 6" stroke={W} stroke-width="16" stroke-linecap="round"></path>
      <path d="M292 24 L 300 6" stroke={L} stroke-width="16" stroke-linecap="round"></path>
    </g>
    <rect x="104" y="74" width="200" height="54" rx="6" fill={O}></rect>
    <g fill={R}><rect x="104" y="90" width="200" height="8"></rect><rect x="104" y="110" width="200" height="8"></rect></g>
    <rect x="104" y="74" width="200" height="54" rx="6" {...shade('k', 'b')}></rect>
    <circle cx="120" cy="110" r="13" fill={T}></circle>
    <circle cx="288" cy="110" r="13" fill={T}></circle>
  </g>
</svg>
