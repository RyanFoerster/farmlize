---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import IlloScarecrow from '../components/illos/IlloScarecrow.astro';
import FunTitle from '../components/FunTitle.astro';
import Floaters from '../components/Floaters.astro';
---

<Base title="Page introuvable" smooth={false} noindex>
  <main class="nf" id="contenu" tabindex="-1" data-nf>
    <Floaters
      items={[
        { name: 'Carottes', x: 12, y: 22, rot: -14, depth: 1.2 },
        { name: 'Cerises', x: 86, y: 18, size: 0.8, rot: 12, depth: 0.8 },
        { name: 'Radis', x: 18, y: 72, size: 0.85, rot: 8, depth: 1.4, desk: true },
      ]}
    />
    <Logo size={32} class="nf__logo" />
    <div class="nf__inner">
      <p class="nf__code display" aria-hidden="true">
        <span>4</span>
        <svg viewBox="0 0 100 100" class="nf__egg riso" data-egg><use href="#ico-oeufs"></use></svg>
        <span>4</span>
      </p>
      <FunTitle as="h1" class="title nf__title" text="Cette page est partie aux [champs|leaf]." />
      <p class="lead">Elle reviendra peut-être à la prochaine récolte. En attendant, les fermes, elles, sont bien là.</p>
      <div class="nf__actions">
        <a href="/fermes" class="btn"><Icon name="map" size={18} /> Explorer la carte</a>
        <a href="/" class="btn btn--ghost">Accueil</a>
      </div>
    </div>
    <IlloScarecrow class="nf__illo" />
  </main>
</Base>

<style>
  .nf {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 100px var(--gutter);
    overflow: hidden;
    text-align: center;
  }
  .nf :global(.nf__logo) {
    position: absolute;
    top: 36px;
    left: var(--gutter);
  }
  .nf__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 640px;
  }
  .nf__code {
    display: flex;
    align-items: center;
    gap: 0.04em;
    margin: 0;
    font-size: clamp(120px, 20vw, 260px);
    line-height: 0.9;
  }
  .nf__egg {
    width: 0.78em;
    height: 0.78em;
  }
  .nf__inner > :global(.nf__title) {
    font-size: clamp(30px, 3.6vw, 52px);
    margin: 18px 0 14px;
  }
  .nf__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 18px;
  }
  :global(.nf__illo) {
    position: absolute;
    right: clamp(0px, 3vw, 40px);
    bottom: 0;
    width: clamp(170px, 24vw, 340px);
    height: auto;
  }
</style>

<script>
  import { gsap, onPage, reduced } from '../lib/motion';
  onPage('[data-nf]', () => {
    if (reduced()) return;
    gsap.from('.nf__code > *', { yPercent: 60, autoAlpha: 0, duration: 1, stagger: 0.1, ease: 'back.out(1.8)' });
    gsap.to('[data-egg]', { rotation: 12, duration: 0.18, yoyo: true, repeat: 7, ease: 'sine.inOut', delay: 1.2, repeatDelay: 0.02 });
    gsap.to('[data-egg]', { rotation: -10, duration: 1.6, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: 2.8 });
  });
</script>
