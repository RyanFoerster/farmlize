---
import { categories } from '../data/categories';
import LogoMark from './LogoMark.astro';

const messages = [
  'On cueille les fraises',
  'On ramasse les œufs',
  'On affine les fromages',
  'On récolte le miel',
  'On sort le pain du four',
  'On remplit le panier',
];
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader__layer loader__layer--coral" data-loader-coral>
    <svg class="loader__curve" viewBox="0 0 100 12" preserveAspectRatio="none"><path data-curve d="M0 0 L100 0 L100 0 Q50 0 0 0 Z"></path></svg>
  </div>
  <div class="loader__layer loader__layer--cream" data-loader-panel>
    <svg class="loader__curve" viewBox="0 0 100 12" preserveAspectRatio="none"><path data-curve d="M0 0 L100 0 L100 0 Q50 0 0 0 Z"></path></svg>

    <div class="loader__center" data-loader-center>
      <div class="loader__plate" data-plate>
        <svg class="loader__ring" viewBox="0 0 160 160">
          <circle class="loader__track" cx="80" cy="80" r="76"></circle>
          <circle class="loader__progress" data-ring cx="80" cy="80" r="76" pathLength="1"></circle>
        </svg>
        <div class="loader__disc" data-disc></div>
        {
          categories.map((c) => (
            <svg class="loader__item riso" data-item data-tint={c.tint} viewBox="0 0 100 100">
              <use href={`#ico-${c.id}`} />
            </svg>
          ))
        }
      </div>
      <div class="loader__logo" data-loader-logo><LogoMark /></div>
      <p class="loader__msg" data-loader-msg data-messages={JSON.stringify(messages)}><span>{messages[0]}…</span></p>
    </div>

    <div class="loader__foot">
      <span class="loader__place">Fermes locales · Belgique</span>
      <span class="loader__count display"><span data-loader-count>0</span><small>%</small></span>
    </div>
  </div>
</div>

<style is:global>
  .loader {
    display: none;
  }
  @media (scripting: enabled) {
    .loader {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: block;
      pointer-events: auto;
      /* filet de sécurité si le script ne démarre pas */
      animation: fz-loader-failsafe 0.4s 9s forwards;
    }
  }
  @keyframes fz-loader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  .loader__layer {
    position: absolute;
    inset: 0;
  }
  .loader__layer--coral {
    background: var(--coral);
  }
  .loader__layer--cream {
    background: var(--cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .loader__curve {
    position: absolute;
    left: 0;
    top: calc(100% - 1px);
    width: 100%;
    height: 14vh;
    overflow: visible;
  }
  .loader__layer--cream .loader__curve path {
    fill: var(--cream);
  }
  .loader__layer--coral .loader__curve path {
    fill: var(--coral);
  }
  .loader__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }
  .loader__plate {
    position: relative;
    width: clamp(132px, 15vw, 172px);
    aspect-ratio: 1;
  }
  .loader__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    overflow: visible;
  }
  .loader__track,
  .loader__progress {
    fill: none;
    stroke-width: 2.5;
  }
  .loader__track {
    stroke: var(--line);
  }
  .loader__progress {
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .loader__disc {
    position: absolute;
    inset: 11px;
    border-radius: 50%;
    background: var(--sand);
  }
  .loader__item {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52%;
    height: 52%;
    margin: -26% 0 0 -26%;
    opacity: 0;
  }
  .loader__logo {
    margin: 0 0 10px;
    font-size: clamp(24px, 2.6vw, 38px);
    color: var(--ink);
  }
  .loader__msg {
    margin: -10px 0 0;
    height: 1.5em;
    overflow: hidden;
    font-size: 15px;
    color: var(--muted);
  }
  .loader__msg span {
    display: block;
  }
  .loader__foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(18px, 4vh, 40px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .loader__place {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .loader__count {
    display: inline-flex;
    align-items: flex-start;
    font-size: clamp(64px, 9vw, 140px);
    line-height: 0.8;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .loader__count small {
    font-size: 0.32em;
    margin: 0.12em 0 0 0.08em;
  }

  /* barre de progression des changements de page */
  .fz-progress {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 1001;
    width: 100%;
    height: 3px;
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
    opacity: 0;
  }
</style>

<script>
  import { gsap, reduced } from '../lib/motion';

  const BOOT = 'farmlize:booted';
  let resolveDone!: () => void;
  (window as any).__fzLoaderDone = new Promise<void>((r) => (resolveDone = r));

  const el = document.querySelector<HTMLElement>('[data-loader]');

  function finish() {
    el?.remove();
    resolveDone();
  }

  if (!el || !window.matchMedia('(scripting: enabled)').matches) finish();
  else if (reduced()) {
    gsap.to(el, { autoAlpha: 0, duration: 0.3, delay: 0.2, onComplete: finish });
  } else {
    run(el);
  }

  function run(el: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(s: string) => el.querySelector<T>(s)!;
    const first = (() => {
      try {
        return !sessionStorage.getItem(BOOT);
      } catch {
        return true;
      }
    })();
    const minTime = first ? 2.4 : 0.9;

    // empêche le défilement pendant le chargement
    const block = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
    };
    el.addEventListener('wheel', block, { passive: false });
    el.addEventListener('touchmove', block, { passive: false });

    const items = [...el.querySelectorAll<SVGElement>('[data-item]')];
    const disc = $('[data-disc]');
    const ring = $<SVGCircleElement>('[data-ring]');
    const count = $('[data-loader-count]');
    const msgEl = $('[data-loader-msg]');
    const messages: string[] = JSON.parse(msgEl.dataset.messages || '[]');
    const logoLetters = el.querySelectorAll('[data-loader-logo] path');

    // --- entrée
    gsap.set(el.querySelectorAll('.loader__foot > *'), { autoAlpha: 0, y: 14 });
    const intro = gsap.timeline();
    intro
      .from($('[data-plate]'), { scale: 0.6, autoAlpha: 0, duration: 0.8, ease: 'back.out(1.8)' })
      .from(logoLetters, { y: 260, duration: 0.8, stagger: 0.04 }, 0.1)
      .from(msgEl, { autoAlpha: 0, y: 10, duration: 0.6 }, 0.35)
      .to(el.querySelectorAll('.loader__foot > *'), { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.08 }, 0.3);

    // --- les produits défilent dans l'assiette
    const cycle = gsap.timeline({ repeat: -1, delay: 0.25 });
    items.forEach((it) => {
      cycle
        .fromTo(it, { scale: 0, rotation: -60, autoAlpha: 1 }, { scale: 1, rotation: 0, duration: 0.42, ease: 'back.out(2.2)' })
        .to(disc, { backgroundColor: it.dataset.tint, duration: 0.35, ease: 'power1.out' }, '<')
        .to(it, { scale: 0, rotation: 50, duration: 0.26, ease: 'power2.in' }, '+=0.12');
    });

    // --- petites phrases
    let mi = 0;
    const msgTimer = window.setInterval(() => {
      mi = (mi + 1) % messages.length;
      const span = msgEl.querySelector('span')!;
      gsap.to(span, {
        yPercent: -100,
        autoAlpha: 0,
        duration: 0.25,
        ease: 'power2.in',
        onComplete: () => {
          span.textContent = `${messages[mi]}…`;
          gsap.fromTo(span, { yPercent: 100, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1, duration: 0.35 });
        },
      });
    }, 700);

    // --- progression : avance seule, puis termine quand la page est prête
    const p = { v: 0 };
    const render = () => {
      count.textContent = String(Math.round(p.v * 100));
      ring.style.strokeDashoffset = String(1 - p.v);
    };
    const crawl = gsap.to(p, { v: 0.86, duration: minTime, ease: 'power2.out', onUpdate: render });

    const pageReady = Promise.all([
      document.fonts?.ready ?? Promise.resolve(),
      document.readyState === 'complete' ? Promise.resolve() : new Promise((r) => window.addEventListener('load', r, { once: true })),
    ]);
    const timeout = new Promise((r) => setTimeout(r, 6000));
    const minWait = new Promise((r) => setTimeout(r, minTime * 1000));

    Promise.all([Promise.race([pageReady, timeout]), minWait]).then(() => {
      crawl.kill();
      gsap.to(p, { v: 1, duration: 0.45, ease: 'power2.inOut', onUpdate: render, onComplete: leave });
    });

    function leave() {
      clearInterval(msgTimer);
      try {
        sessionStorage.setItem(BOOT, '1');
      } catch {}
      const panel = $('[data-loader-panel]');
      const coral = $('[data-loader-coral]');
      const curves = el.querySelectorAll('[data-curve]');
      const out = gsap.timeline({
        onComplete: () => {
          cycle.kill();
          finish();
        },
      });
      out
        .to(el.querySelectorAll('[data-item]'), { scale: 0, duration: 0.3, ease: 'power2.in' })
        .to($('[data-plate]'), { scale: 0.7, autoAlpha: 0, duration: 0.45, ease: 'power3.in' }, 0)
        .to(logoLetters, { y: -260, duration: 0.5, stagger: 0.03, ease: 'power3.in' }, 0.05)
        .to([msgEl, ...el.querySelectorAll('.loader__foot > *')], { autoAlpha: 0, y: -12, duration: 0.35, ease: 'power2.in' }, 0)
        // le rideau crème se lève, le corail suit
        .add('lift', 0.45)
        .to(curves, { attr: { d: 'M0 0 L100 0 L100 0 Q50 12 0 0 Z' }, duration: 0.5, ease: 'power2.in' }, 'lift')
        .to(panel, { yPercent: -100, duration: 1, ease: 'power4.inOut' }, 'lift')
        .to(coral, { yPercent: -100, duration: 1, ease: 'power4.inOut' }, 'lift+=0.12')
        .to(curves, { attr: { d: 'M0 0 L100 0 L100 0 Q50 0 0 0 Z' }, duration: 0.5, ease: 'power2.out' }, 'lift+=0.55')
        // les animations de la page démarrent pendant que le rideau se lève
        .add(() => resolveDone(), 'lift+=0.45');
    }
  }

  // --- navigations suivantes : pas de loader, une fine barre de progression
  document.addEventListener('astro:after-swap', () => document.querySelector('[data-loader]')?.remove());

  let bar: HTMLElement | null = null;
  let barTween: gsap.core.Tween | null = null;
  document.addEventListener('astro:before-preparation', () => {
    // le rideau illustré (PageTransition) s'en charge ; la barre reste pour le mouvement réduit
    if (!reduced()) return;
    if (!bar) {
      bar = document.createElement('div');
      bar.className = 'fz-progress';
      document.documentElement.appendChild(bar);
    }
    barTween?.kill();
    gsap.set(bar, { opacity: 1, scaleX: 0 });
    barTween = gsap.to(bar, { scaleX: 0.8, duration: 2.4, ease: 'power2.out', delay: 0.12 });
  });
  document.addEventListener('astro:after-swap', () => {
    if (!bar) return;
    barTween?.kill();
    barTween = gsap.to(bar, {
      scaleX: 1,
      duration: 0.25,
      ease: 'power2.out',
      onComplete: () => void gsap.to(bar, { opacity: 0, duration: 0.35 }),
    });
  });
</script>
