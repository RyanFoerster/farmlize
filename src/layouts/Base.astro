---
import { ClientRouter } from 'astro:transitions';
import SvgDefs from '../components/SvgDefs.astro';
import Loader from '../components/Loader.astro';
import PageTransition from '../components/PageTransition.astro';
import '../styles/global.css';
import { SITE_NAME, DEFAULT_DESCRIPTION, canonicalPath } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Défilement fluide (Lenis) — désactivé sur la carte */
  smooth?: boolean;
  bodyClass?: string;
  /** Page à ne pas indexer (planche interne, 404) */
  noindex?: boolean;
  /** Données structurées schema.org de la page */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = DEFAULT_DESCRIPTION, smooth = true, bodyClass, noindex = false, jsonLd } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — Trouvez les fermes près de chez vous`;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(canonicalPath(Astro.url.pathname), site).href;
const ogImage = new URL('/og.png', site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="fr-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <!-- aperçu quand la page est partagée (réseaux, messageries) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Farmlize : les fermes locales de Belgique, illustrées en risographie" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#FCFAF2" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    {ld.map((d) => <script is:inline type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <ClientRouter />
  </head>
  <body class={bodyClass} data-smooth={smooth ? '' : undefined}>
    <!-- premier arrêt au clavier : sauter le menu -->
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <SvgDefs />
    <Loader />
    <PageTransition />
    <slot />
  </body>
</html>

<script>
  import Lenis from 'lenis';
  import { gsap, ScrollTrigger, reduced, loaderDone, magnetic, layerizeScrub } from '../lib/motion';
  import { initClickGarden } from '../lib/click-garden';

  initClickGarden();

  // Perf : les boucles CSS (illustrations qui flottent, se balancent, tournent…) se figent quand leur
  // section est hors de l'écran — le navigateur n'a plus à les redessiner pour rien.
  const offscreen = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.target.classList.toggle('is-offscreen', !e.isIntersecting)),
    { rootMargin: '120px 0px' },
  );
  document.addEventListener('astro:page-load', async () => {
    document.querySelectorAll('main section, footer').forEach((s) => offscreen.observe(s));
    // et tout ce qui suit le scroll reçoit son propre calque (une fois les animations des pages créées)
    await loaderDone();
    await document.fonts.ready;
    requestAnimationFrame(() => requestAnimationFrame(layerizeScrub));
    setTimeout(layerizeScrub, 1500);
  });
  document.addEventListener('astro:before-swap', () => offscreen.disconnect());
  ScrollTrigger.addEventListener('refresh', layerizeScrub);

  // Tous les boutons suivent un peu la souris, comme celui du hero de l'accueil
  // (les petits boutons ronds ou en pilule plus doucement, pour rester dans leur cadre).
  const magnets: (() => void)[] = [];
  document.addEventListener('astro:page-load', async () => {
    await loaderDone();
    document.querySelectorAll<HTMLElement>('.btn').forEach((el) => magnets.push(magnetic(el, 0.18)));
    document
      .querySelectorAll<HTMLElement>('.menu-btn, .fav-pill, .round-btn, .s-arrow, .ex-recenter, .ex-filter-btn')
      .forEach((el) => magnets.push(magnetic(el, 0.12)));
  });
  document.addEventListener('astro:before-swap', () => magnets.splice(0).forEach((off) => off()));

  let lenis: Lenis | null = null;
  const raf = (time: number) => lenis?.raf(time * 1000);

  document.addEventListener('astro:page-load', async () => {
    await loaderDone();
    if (lenis || !document.body.hasAttribute('data-smooth') || reduced()) return;
    lenis = new Lenis({ lerp: 0.11, wheelMultiplier: 0.95 });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add(raf);
    gsap.ticker.lagSmoothing(0);
    // ancres internes : défilement doux, puis le focus suit (clavier, lecteur d'écran) et l'adresse garde l'ancre
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
      a.addEventListener('click', (e) => {
        const hash = a.getAttribute('href')!;
        const target = hash.length > 1 ? document.querySelector<HTMLElement>(hash) : null;
        if (!target) return;
        e.preventDefault();
        lenis?.scrollTo(target, { offset: -90, duration: 1.4 });
        if (!target.matches('a, button, input, select, textarea, [tabindex]')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        history.replaceState(history.state, '', hash);
      }),
    );
    (window as any).__lenis = lenis;
  });

  document.addEventListener('astro:before-swap', () => {
    gsap.ticker.remove(raf);
    lenis?.destroy();
    lenis = null;
    (window as any).__lenis = null;
  });
</script>
